# Backend
APP_ENV=development
DATABASE_URL=sqlite+aiosqlite:///../data/myvocabulary.db
SECRET_KEY=change-me-in-production-use-openssl-rand-hex-32
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS_LEARNER=30
REFRESH_TOKEN_EXPIRE_DAYS_PARENT=7
AUDIO_DIR=./data/audio
DICTIONARY_API_URL=https://api.dictionaryapi.dev/api/v2/entries/en
DICTIONARY_FALLBACK_API_URL=https://api.suvankar.cc/dictionaryapi/v1/definitions/en
TTS_VOICE=en-US-JennyNeural
CORS_ORIGINS=http://localhost:5173,http://localhost:8080
DEBUG=true
# AI level assessment — OpenCode Go (OpenAI-compatible)
OPENAI_API_KEY=
OPENAI_API_BASE=https://opencode.ai/zen/go/v1
OPENAI_MODEL=mimo-v2.5

# Frontend (copy to frontend/.env)
VITE_API_BASE_URL=http://localhost:8000/api/v1
